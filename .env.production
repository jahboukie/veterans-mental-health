# CANADIAN VETERAN MENTAL HEALTH PLATFORM - PRODUCTION ENVIRONMENT

# Application Configuration
VITE_APP_ENV=production
VITE_APP_REGION=canada
VITE_APP_NAME=VetSupport Canada

# Production URLs
VITE_APP_URL=https://vetsupport.ca
VITE_FAMILY_APP_URL=https://family-support.vetsupport.ca

# Ecosystem Integration (Production)
VITE_SENTIMENT_SERVICE_URL=https://sentimentasaservice.com
VITE_AI_ORCHESTRATION_URL=https://ai-orchestration.yourecosystem.com
VITE_ANALYTICS_ENGINE_URL=https://analytics.yourecosystem.com
VITE_API_GATEWAY_URL=https://api.yourecosystem.com

# Canadian Veteran Resources (Fixed)
VITE_VAC_CRISIS_LINE=1-800-268-7708
VITE_CANADA_SUICIDE_PREVENTION=1-833-456-4566
VITE_VAC_BENEFITS_LINE=1-866-522-2122
VITE_OSISS_SUPPORT_LINE=1-800-883-6094

# Production Security
VITE_ENCRYPTION_ENABLED=true
VITE_HIPAA_LOGGING=true
VITE_AUDIT_LEVEL=full

# Canadian Compliance (Production)
VITE_PIPEDA_COMPLIANCE=true
VITE_BILINGUAL_SUPPORT=true
VITE_FRENCH_LANGUAGE=true

# Veterans Affairs Canada Integration (Production)
VITE_VAC_API_ENDPOINT=https://api.veterans.gc.ca
VITE_VAC_BENEFITS_INTEGRATION=true
VITE_PROVINCIAL_RESOURCES=true

# Production Analytics
VITE_ANALYTICS_ENABLED=true
VITE_ERROR_TRACKING=true
VITE_PERFORMANCE_MONITORING=true

# Crisis Prevention (Production)
VITE_CRISIS_MONITORING=true
VITE_AUTOMATIC_ALERTS=true
VITE_FAMILY_NOTIFICATIONS=true

# Demo Configuration
VITE_VC_DEMO_MODE=true
VITE_DEMO_REGION=canada